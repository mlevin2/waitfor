#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
waitfor: wait for one or more processes, then run a command

Usage:
  waitfor [options] <pid|query>... [-- <command> [args...]]

Targets:
  - If an argument is all digits, it is treated as a PID.
  - Otherwise it is treated as a substring match against `ps` output.
    If the match is unambiguous, that PID is used.
    If ambiguous, fzf is used to select one or more processes.

Options:
  --all                 Wait for all targets (default).
  --any, --first         Proceed when any one target exits.
  -t, --timeout DURATION  Max time to wait before failing (default: no timeout).
                        Format: N, Ns, Nm, Nh, Nd (integers)
  --settle SECONDS      Sleep this long after the wait completes (default: 0).
  --interval SECONDS    Poll interval in seconds (default: 2).
  -q, --quiet            Less output.
  --notify               Best-effort desktop notification (after wait+settle,
                        and when a post-wait command finishes, if any).
  -h, --help             Show this help.

Examples:
  waitfor 12345 -- cp file1 /var/www/files/file1
  waitfor "python myjob.py" --any --settle 3 -- notify-send done
  waitfor node postgres
  waitfor --notify 12345 -- rsync -a src/ dist/
EOF
}

err() { printf '%s\n' "$*" >&2; }

# Truncate a string for notification bodies.
_waitfor_abbrev() {
  local s=$1
  local max=120
  ((${#s} > max)) && printf '%s' "${s:0:max}..." || printf '%s' "$s"
}

# One-line summary: each target as "PID (command)"; commands from ps at snapshot time
# (we capture before the wait, because the process is gone when the wait ends).
_waitfor_pids_pretty() {
  local pid cl s t
  s=""
  t=""
  for pid in "$@"; do
    [[ -n "$pid" ]] || continue
    cl="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    cl="$(printf '%s' "$cl" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    cl="$(_waitfor_abbrev "$cl")"
    t="$pid (command not available yet)"
    if [[ -n "$cl" ]]; then
      t="$pid ($cl)"
    fi
    if [[ -n "$s" ]]; then
      s="${s}; ${t}"
    else
      s=$t
    fi
  done
  printf '%s' "$s"
}

# System tray / desktop bubble via Windows PowerShell (not pwsh on Linux).
_waitfor_ps_toast() {
  local title=$1
  local body=$2
  local p
  p=$(command -v powershell.exe 2>/dev/null) || p=$(command -v powershell 2>/dev/null) || return 1
  local ps1
  if ! ps1=$(mktemp "${TMPDIR:-/tmp}/wftoast-XXXXXX.ps1"); then
    return 1
  fi
  cat >"$ps1" <<'PST'
param([string]$T,[string]$B)
Add-Type -AssemblyName System.Windows.Forms | Out-Null
$ni = New-Object System.Windows.Forms.NotifyIcon
$ni.Icon = [System.Drawing.SystemIcons]::Information
$ni.Visible = $true
$ni.ShowBalloonTip(12000, $T, $B, 'Info')
Start-Sleep -Seconds 1
$ni.Dispose()
PST
  if MSYS2_ARG_CONV_EXCL="*" "$p" -NoProfile -ExecutionPolicy Bypass -File "$ps1" -T "$title" -B "$body" 2>/dev/null; then
    rm -f "$ps1"
    return 0
  fi
  rm -f "$ps1"
  return 1
}

# Try the Windows notifier only on Windows-like hosts or WSL (powershell.exe, not Linux pwsh).
_waitfor_ps_toast_wsl() {
  command -v powershell.exe >/dev/null 2>&1 || return 1
  _waitfor_ps_toast "$1" "$2"
}

_waitfor_notify_try_builtin() {
  local title=$1
  local body=$2
  local u
  u=$(uname -s 2>/dev/null || true)

  if [[ "$u" = "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
    if osascript \
      -e 'on run argv' \
      -e '  display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' \
      -- "$title" "$body" 2>/dev/null; then
      return 0
    fi
  fi

  if command -v notify-send >/dev/null 2>&1; then
    if notify-send "$title" "$body" 2>/dev/null; then
      return 0
    fi
  fi

  if [[ -n "${OS-}" && "$OS" = "Windows_NT" ]] || [[ "$u" = MINGW* || "$u" = MSYS* || "$u" = CYGWIN* ]]; then
    if _waitfor_ps_toast "$title" "$body"; then
      return 0
    fi
  fi

  if [[ "$u" = "Linux" ]]; then
    if _waitfor_ps_toast_wsl "$title" "$body"; then
      return 0
    fi
  fi

  return 1
}

# $1 title, $2 body, $3 1=disable "no backend" message (same as -q for notify warnings only)
waitfor_notify() {
  local title=$1
  local body=$2
  local quietish=${3:-0}

  if [[ -n "${WAITFOR_NOTIFY_CMD:-}" ]]; then
    "$WAITFOR_NOTIFY_CMD" "$title" "$body" 2>/dev/null || true
    return 0
  fi
  if _waitfor_notify_try_builtin "$title" "$body"; then
    return 0
  fi
  if [[ "$quietish" -eq 0 ]]; then
    err "waitfor: --notify: no notifier; see README, or set WAITFOR_NOTIFY_CMD"
  fi
  return 0
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    err "Missing required command on PATH: $1"
    exit 1
  }
}

parse_duration_seconds() {
  # Accept: N, Ns, Nm, Nh, Nd (integers only)
  # Examples: 600, 10m, 2h
  local s=$1
  if [[ "$s" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$s"
    return 0
  fi

  if [[ "$s" =~ ^([0-9]+)([smhd])$ ]]; then
    local n=${BASH_REMATCH[1]}
    local u=${BASH_REMATCH[2]}
    case "$u" in
      s) printf '%s\n' "$n" ;;
      m) printf '%s\n' $(( n * 60 )) ;;
      h) printf '%s\n' $(( n * 3600 )) ;;
      d) printf '%s\n' $(( n * 86400 )) ;;
    esac
    return 0
  fi

  err "Invalid duration: $s (expected N, Ns, Nm, Nh, or Nd)"
  return 2
}

pid_exists() {
  # `kill -0` can be ambiguous (EPERM). `ps -p` is simple and portable.
  # Treat zombies as "done"; they have exited but haven't been reaped yet.
  local stat
  stat="$(ps -p "$1" -o stat= 2>/dev/null | tr -d ' ' || true)"
  [[ -n "$stat" ]] || return 1
  [[ "$stat" == *Z* ]] && return 1
  return 0
}

is_pid() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

ps_list() {
  # Keep formatting stable for both parsing and display.
  # etime is useful context when picking in fzf.
  ps -ax -o pid=,etime=,command=
}

resolve_query_to_pids() {
  local query=$1
  local psout
  # Avoid the common footgun where the query string matches this wrapper itself.
  psout="$(ps_list | awk -v self="$$" '$1 != self {print}')"

  local matches
  matches="$(printf '%s\n' "$psout" | rg --fixed-strings --ignore-case -- "$query" || true)"

  # If the query is also present in other waitfor invocations, ignore those.
  # (Common when you re-run the same wait in multiple terminals.)
  matches="$(printf '%s\n' "$matches" | awk '$0 !~ /(^|[[:space:]])waitfor([[:space:]]|$)/ && $0 !~ /\/waitfor([[:space:]]|$)/' || true)"

  if [[ -z "$matches" ]]; then
    err "No processes matched query: $query"
    return 1
  fi

  local count
  count="$(printf '%s\n' "$matches" | wc -l | tr -d ' ')"

  if [[ "$count" == "1" ]]; then
    printf '%s\n' "$matches" | awk '{print $1}'
    return 0
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    err "Query matched multiple processes and fzf is not installed: $query"
    err "Matches were:"
    printf '%s\n' "$matches" >&2
    return 1
  fi

  # In scripts/CI, fzf will block or fail; don't attempt an interactive prompt.
  if [[ ! -t 0 || ! -t 1 ]]; then
    err "Query matched multiple processes (non-interactive); refusing to prompt: $query"
    err "Matches were:"
    printf '%s\n' "$matches" >&2
    return 1
  fi

  local picked
  picked="$(
    printf '%s\n' "$matches" |
      fzf --multi --ansi --prompt="waitfor ($query) > " --height=40% --border=rounded
  )"

  if [[ -z "$picked" ]]; then
    err "No selection made for query: $query"
    return 1
  fi

  printf '%s\n' "$picked" | awk '{print $1}'
}

wait_for_pids_all() {
  local interval=$1; shift
  local timeout=$1; shift
  local pids=("$@")
  local start=$SECONDS

  while :; do
    local alive=0
    for pid in "${pids[@]}"; do
      if pid_exists "$pid"; then
        alive=1
      fi
    done
    (( alive == 0 )) && return 0
    if [[ "$timeout" != "0" ]] && (( (SECONDS - start) >= timeout )); then
      return 124
    fi
    sleep "$interval"
  done
}

wait_for_pids_any() {
  local interval=$1; shift
  local timeout=$1; shift
  local pids=("$@")
  local start=$SECONDS

  while :; do
    for pid in "${pids[@]}"; do
      if ! pid_exists "$pid"; then
        return 0
      fi
    done
    if [[ "$timeout" != "0" ]] && (( (SECONDS - start) >= timeout )); then
      return 124
    fi
    sleep "$interval"
  done
}

_waitfor_try_completion() {
  # Resolve symlinks (e.g. ~/bin/waitfor -> .../software/waitfor/waitfor) so tools/ is found.
  local _self _dir
  _self="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
  _dir="$(cd "$(dirname "$_self")" && pwd -P)"
  if [[ ! -f "$_dir/tools/completion_bootstrap.py" ]]; then
    err "waitfor: completion support missing: $_dir/tools/"
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    err "waitfor: python3 is required for shell completions (see README)."
    exit 1
  fi
  python3 "$_dir/tools/completion_bootstrap.py" "$_self" "$@"
  local rc=$?
  if [[ "$rc" -eq 125 ]]; then
    err "waitfor: completion handler did not recognize the request."
    exit 1
  fi
  exit "$rc"
}

main() {
  if [[ $# -ge 1 ]]; then
    case "$1" in
      --_complete-options | --print-completion | install-completion)
        _waitfor_try_completion "$@"
        ;;
    esac
  fi

  need_cmd ps
  need_cmd rg

  local mode=all
  local settle=0
  local interval=2
  local timeout=0
  local quiet=0
  local notify=0

  local -a targets=()
  local -a cmd=()
  local saw_delim=0

  while [[ $# -gt 0 ]]; do
    if [[ "$saw_delim" == 1 ]]; then
      cmd+=("$1")
      shift
      continue
    fi

    case "$1" in
      --)
        saw_delim=1
        shift
        ;;
      --all)
        mode=all
        shift
        ;;
      --any|--first)
        mode=any
        shift
        ;;
      --timeout|-t)
        shift
        [[ $# -gt 0 ]] || { err "--timeout requires a value"; exit 2; }
        timeout="$(parse_duration_seconds "$1")"
        shift
        ;;
      --settle)
        shift
        [[ $# -gt 0 ]] || { err "--settle requires a value"; exit 2; }
        settle="$1"
        shift
        ;;
      --interval)
        shift
        [[ $# -gt 0 ]] || { err "--interval requires a value"; exit 2; }
        interval="$1"
        shift
        ;;
      -q|--quiet)
        quiet=1
        shift
        ;;
      --notify)
        notify=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --*)
        err "Unknown option: $1"
        err "Run: waitfor --help"
        exit 2
        ;;
      *)
        targets+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#targets[@]} -eq 0 ]]; then
    usage
    exit 2
  fi

  local -a pids=()
  local t
  for t in "${targets[@]}"; do
    if is_pid "$t"; then
      pids+=("$t")
      continue
    fi

    local resolved
    if ! resolved="$(resolve_query_to_pids "$t")"; then
      exit 1
    fi
    while IFS= read -r pid; do
      [[ -n "$pid" ]] && pids+=("$pid")
    done <<<"$resolved"
  done

  local -a uniq=()
  local pid
  for pid in "${pids[@]}"; do
    local seen=0
    if ((${#uniq[@]} > 0)); then
      local u
      for u in "${uniq[@]}"; do
        if [[ "$u" == "$pid" ]]; then
          seen=1
          break
        fi
      done
    fi
    if (( seen == 0 )); then
      uniq+=("$pid")
    fi
  done
  if ((${#uniq[@]} > 0)); then
    pids=("${uniq[@]}")
  else
    pids=()
  fi

  if [[ ${#pids[@]} -eq 0 ]]; then
    err "No PIDs selected/resolved."
    exit 1
  fi

  # Snapshot for notifications (and stderr), before targets may exit.
  local pids_pretty
  pids_pretty="$(_waitfor_pids_pretty "${pids[@]}")"

  if [[ "$quiet" == 0 ]]; then
    err "Waiting mode: $mode"
    err "PIDs: ${pids[*]}"
    err "Targets: $pids_pretty"
  fi

  local rc=0
  if [[ "$mode" == "all" ]]; then
    wait_for_pids_all "$interval" "$timeout" "${pids[@]}" || rc=$?
  else
    wait_for_pids_any "$interval" "$timeout" "${pids[@]}" || rc=$?
  fi

  if [[ "$rc" != "0" ]]; then
    if [[ "$rc" == "124" ]]; then
      if [[ "$quiet" == 0 ]]; then
        err "Timed out after ${timeout}s."
      fi
      if [[ "$notify" -eq 1 ]]; then
        waitfor_notify "waitfor" "Timed out after ${timeout}s — $pids_pretty" "$quiet"
      fi
      exit 124
    fi
    exit "$rc"
  fi

  if [[ "$settle" != "0" ]]; then
    if [[ "$quiet" == 0 ]]; then
      err "Settling for ${settle}s..."
    fi
    sleep "$settle"
  fi

  if [[ "$notify" -eq 1 ]]; then
    waitfor_notify "waitfor" "Finished waiting: $pids_pretty" "$quiet"
  fi

  if [[ ${#cmd[@]} -eq 0 ]]; then
    exit 0
  fi

  if [[ "$notify" -eq 0 ]]; then
    exec "${cmd[@]}"
  fi

  set +e
  "${cmd[@]}"
  rc=$?
  set -e
  if [[ "$notify" -eq 1 ]]; then
    local c0
    c0="${cmd[0]##*/}"
    waitfor_notify "waitfor" "Command \"$c0\" finished (exit $rc): $(_waitfor_abbrev "${cmd[*]}")" "$quiet"
  fi
  exit "$rc"
}

main "$@"
